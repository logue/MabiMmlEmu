{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "mabinogi-mml-player",
  "version": "3.4.0",
  "description": "Mabinogi MML Web Player",
  "type": "module",
  "keywords": [
    "Mabinogi",
    "MML",
    "music-macro-language",
    "midi",
    "webplayer",
    "smfplayer"
  ],
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "homepage": "https://github.com/logue/MabiMmlEmu",
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/MabiMmlEmu.git"
  },
  "bugs": {
    "url": "https://github.com/logue/MabiMmlEmu/issues"
  },
  "files": [
    "dist",
    "MSXSprint.sf2"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.1.2",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:clean": "rimraf dist",
    "lint": "eslint . --fix --cache --cache-location ./node_modules/.vite/vite-plugin-eslint && prettier . --write",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@logue/sf2synth": "^0.9.0",
    "@logue/smfplayer": "^0.8.0",
    "@popperjs/core": "^2.11.8",
    "@zip.js/zip.js": "^2.8.26",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "dseg": "^0.46.0",
    "query-string": "^9.3.1",
    "streamsaver": "^2.0.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "sass": "^1.99.0",
    "vite": "^8.0.13",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-checker": "^0.13.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,json,yml,yaml,vue,htm,html}": "eslint --fix --cache --cache-location ./node_modules/.vite/vite-plugin-eslint",
    "*.{css,sass,scss,vue,htm,html}": "stylelint --fix --cache --cache-location ./node_modules/.vite/vite-plugin-stylelint",
    "*": "prettier -w -u"
  }
}
